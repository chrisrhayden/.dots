#!/usr/bin/env python

import sys

from typing import TextIO, List


def hex_to_vals(start_hex: str) -> None | List[str]:
    assert len(start_hex) > 0

    hex = start_hex[1:] if start_hex[0] == "#" else start_hex
    hex_len = len(hex)

    vals = []

    if hex_len == 3:
        vals.append(int(hex[0], 16))
        vals.append(int(hex[1], 16))
        vals.append(int(hex[1], 16))
    elif hex_len == 6:
        vals.append(int(hex[0:2], 16))
        vals.append(int(hex[2:4], 16))
        vals.append(int(hex[4:6], 16))
    else:
        print(f"bad hex code {start_hex}")
        return None

    return vals


def print_hex(h: str):
    vals = hex_to_vals(h)
    if not vals:
        return

    print(
        "\x1b[0;48;2;{};{};{}m{}\x1b[0m".format(vals[0], vals[1], vals[2], h),
    )


def io_hex(hexs: TextIO):
    for h in hexs:
        print_hex(h.strip())


def str_hex(hexs: str):
    for h in hexs.splitlines():
        print_hex(h.strip())


if __name__ == "__main__":
    if sys.stdin.isatty():
        if len(sys.argv) < 2:
            print("no args passed")
            exit(1)
        str_hex(sys.argv[1])
    else:
        io_hex(sys.stdin)
