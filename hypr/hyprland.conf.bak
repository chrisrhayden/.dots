# hypr config

# Source a file (multi-file configs)
# source = ~/.config/hypr/myColors.conf

$active_border = rgb(255,255,255)
$inactive_border = rgb(59,59,59)
$accent = rgb(223,106,136)
$font_family = Cartograph CF
$rounding = 5

# See https://wiki.hyprland.org/Configuring/Monitors/
# monitor=,preferred,auto,auto
# monitor=,preferred,auto,auto
# monitor=name,addreserved,TOP,BOTTOM,LEFT,RIGHT
# eww is 26px tall and hypr has 14px outside so we add 12px as reserved space
# monitor=,addreserved,0,24,0,0
# monitor=0,12,0,0
# monitor=,addreserved,0,18,0,0
monitor = eDP-2, 1920x1080, 0x0, 1
monitor = DP-2, 1920x1080, 0x0, 1
monitor = HDMI-A-1, 1920x1080, 1920x0, 1
monitor = HDMI-A-1,addreserved,0,12,0,0
monitor = DP-2,addreserved,0,12,0,0
monitor = eDP-2,addreserved,0,12,0,0

# Execute your favorite apps at launch
exec-once = hyprpaper
exec-once = hypridle
exec-once = dunst
exec-once = just --justfile ~/.dots/ok_shell/justfile run
# exec-once = steam

env = HYPRCURSOR_THEME,rose-pine-hyprcursor
env = HYPRCURSOR_SIZE,34

ecosystem {
    no_update_news = true
}

input {
    kb_layout = us
    kb_options = caps:none

    follow_mouse = 1
    # sensitivity = -0.9 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        tap-to-click = false
        natural_scroll = no
        # scroll_factor = 0
    }

}

device {
    name = elan0300:00-04f3:3206-touchpad
    # sensitivity = -0.7
}

device {
    name = clearly-superior-technologies.-cst-laser-trackball
    sensitivity = -0.9
}

device {
    name = logitech-m325
    sensitivity = -0.9
}

general {
    gaps_in = 4
    gaps_out = 14
    border_size = 2
    col.active_border = $active_border
    col.inactive_border = $inactive_border

    layout = dwindle
}

group {
    col.border_active = $active_border
    col.border_inactive = $inactive_border

    groupbar {
        height = 1
        indicator_height = 20
        text_offset = -10
        keep_upper_gap = false
        rounding = $rounding
        round_only_edges = true

        font_family = $font_family
        font_size = 14
        font_weight_active = Bold
        font_weight_inactive = Bold

        text_color = rgb(0,0,0)
        text_color_locked_active = rgb(0,0,0)
        text_color_inactive = rgb(255,255,255)
        text_color_locked_inactive = $accent

        col.active = $active_border
        col.locked_active = $accent
        col.inactive = $inactive_border
        col.locked_inactive = $inactive_border
    }
}

decoration {
    # See https://wiki.hyprland.org/Configuring/Variables/ for more

    rounding = $rounding

    blur {
        enabled = true
        size = 3
        passes = 1
        new_optimizations = true
    }

    shadow {
        enabled = true
        range = 4
        render_power = 3
        # ignore_window = true
        color = rgba(1a1a1aee)
    }
}
