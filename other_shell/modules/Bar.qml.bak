import Quickshell
import QtQuick
import QtQuick.Layouts
import Quickshell.Widgets

import qs

PanelWindow {
    id: root
    required property ShellScreen modelData

    anchors {
        left: true
        right: true
        bottom: true
    }

    implicitHeight: 20

    color: Style.colors.bg

    margins {
        left: 14
        right: 14
    }

    Item {
        anchors.fill: parent
        // implicitWidth: parent.width

        Component.onCompleted: console.log("rl <><>")
        RowLayout {
            id: rl
            anchors.fill: parent
            Layout.fillWidth: true

            // height: parent.height
            // width: parent.width

            Item {
                Layout.fillHeight: true
                LeftBar {
                    screen: root.modelData
                }
            }
            Item {
                Layout.fillHeight: true
                Layout.alignment: Qt.AlignHCenter
                Clock {}
            }
            Item {
                Layout.fillHeight: true
                Layout.alignment: Qt.AlignRight

                Rectangle {
                    height: parent.height

                    width: 100

                    Component.onCompleted: {
                        console.log("fuck you so much", height);
                    }

                    color: "black"
                }
            }
        }
    }
}
